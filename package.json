{
  "name": "ionlab-refinery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:cf": "node scripts/build-cf.mjs",
    "start": "next start -p 3000",
    "cf:db:init": "wrangler d1 execute ionlab-refinery --remote --file=./schema.sql",
    "cf:deploy": "npm run build:cf && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.0.2",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "wrangler": "^4.14.0"
  }
}
